# ---- 統合済みページの301リダイレクト (2026-08-25 コンテンツ整理) ----
# カオスゲームは IFS の描画法そのもの
Redirect 301 /chaosgame.php /ifs.php
# 信号ダッシュボードは他ページの寄せ集め
Redirect 301 /console.php /waves.php
# 循環セルオートマトンの後継実装（Day 208 の cyclic）
Redirect 301 /cyclicca.php /cyclic.php
# 転がる円の軌跡 ⊂ スピログラフ
Redirect 301 /cycloid.php /spirograph.php
# pendulum に二重振り子モードあり
Redirect 301 /doublepend.php /pendulum.php
# 単純ランダムウォーク ⊂ レヴィフライト
Redirect 301 /drift.php /galton.php
# 円形膜モード ⊂ 振動の節線
Redirect 301 /drumhead.php /chladni.php
# 干渉縞 ⊂ 波動場
Redirect 301 /interference.php /waves.php
# 等高線場 = メタボールの等値面
Redirect 301 /isofield.php /diffgrow.php
# リサジュー = 減衰なしハーモノグラフ
Redirect 301 /lissajous.php /harmonograph.php
# 迷路生成 ⊂ 迷路
Redirect 301 /mazegen.php /maze.php
# 幾何光線の反射/屈折で二重
Redirect 301 /optics.php /caustics.php
# ケプラー2体 ⊂ N体重力
Redirect 301 /orbit.php /nbody.php
# 波紋 ⊂ 波動場
Redirect 301 /ripple.php /waves.php
# ローレンツガス = シナイ・ビリヤード
Redirect 301 /scatter.php /billiard.php
# バネ振り子カオス ⊂ 振り子カオス
Redirect 301 /spring.php /pendulum.php
# ターマイト = ラングトンのアリの一般化
Redirect 301 /turmite.php /life.php
# 点渦 ⊂ カルマン渦列
Redirect 301 /vortex.php /karman.php
# 森林火災 = 動的パーコレーション
Redirect 301 /wildfire.php /sandpile.php
# セルラーノイズ = ボロノイ距離場
Redirect 301 /worley.php /foam.php
# XYモデル = 連続スピンのイジング
Redirect 301 /xymodel.php /reaction.php
# 一覧未掲載のまま残っていた孤児ページ
Redirect 301 /golden.php /fibonacci.php
Redirect 301 /flow.php /fluidveil.php
# バーニングシップ = 絶対値つきのマンデルブロ。fractal の SHIP モード
Redirect 301 /burningship.php /fractal.php
# マルチブロ = z^d のマンデルブロ。fractal の z^d モード（d 連続変化）
Redirect 301 /multibrot.php /fractal.php
# sin/exp の脱出時間フラクタル = 式を替えたマンデルブロ。fractal の SIN / EXP モード
Redirect 301 /transcend.php /fractal.php
# B/S 規則の切替 = ライフゲームの規則空間。life に規則スイッチ18個とプリセットを統合
Redirect 301 /lifelike.php /life.php
# 優先的選択の成長 = ネットワークの育ち方の比較。network の HUBS モード（一様と優先を左右で同時成長）
Redirect 301 /scalefree.php /network.php
# 非周期タイル = ペンローズと同じ体験。penrose の HAT モード（本物のメタタイル置換で作り直し）
Redirect 301 /monotile.php /penrose.php
# ---- ここまで ----

